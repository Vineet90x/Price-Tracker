# Environment variables for the whole stack. This template IS committed; the real values go in `.env` (NOT committed).
#   cp .env.example .env      then fill in the values below
# `docker compose` reads `.env` from the repo root automatically and passes these into the backend container
# (see the `environment:` block in docker-compose.yml). The frontend needs none: it can't keep secrets,
# and it gets its config (e.g. the Google client ID) from GET /api/auth/config at runtime.

# REQUIRED. Signs the access tokens; anyone who has it can create valid logins. Long and random, never shared.
# Generate one:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Access-token lifetime in seconds (900 = 15 min). Set to 30 to watch the silent refresh happen while testing.
ACCESS_TOKEN_SECONDS=900

# Refresh-token (httpOnly cookie) lifetime in days.
REFRESH_TOKEN_DAYS=7

# true only behind HTTPS: browsers drop "Secure" cookies on plain http://localhost.
COOKIE_SECURE=false

# false = no Binance connection (offline work); simulated NSE stocks keep running.
ENABLE_BINANCE=true

# Google Cloud Console → APIs & Services → Credentials → OAuth client (Web application).
# Public, not a secret. Leave empty to hide the "Continue with Google" button.
GOOGLE_CLIENT_ID=
