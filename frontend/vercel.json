{
  "buildCommand": "npm run build",
  "outputDirectory": "dist/price-tracker/browser",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://price-tracker-api-m88k.onrender.com/api/:path*"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.csr.html"
    }
  ]
}
